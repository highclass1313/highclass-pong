# © 2025 HighClass Pong — copy to .env and fill in. NEVER commit .env.
#
# ⚠️  The wallet below becomes the PERMANENT OWNER of the deployed contract.
#     Whoever holds this key controls match resolution and house withdrawals.
#     Use a dedicated wallet. Never share or commit this value.

DEPLOYER_PRIVATE_KEY=

# Deployed contract address (filled in automatically by scripts/deploy.js,
# but set it manually here if you are running the oracle against an existing
# deployment).
CONTRACT_ADDRESS=

# Which chain the oracle talks to: 25 = Cronos Mainnet, 338 = Cronos Testnet
CHAIN_ID=338

# Optional RPC overrides (defaults are the public Cronos endpoints)
CRONOS_RPC_URL=
CRONOS_TESTNET_RPC_URL=

# Optional — for `npx hardhat verify` on Cronoscan
CRONOSCAN_API_KEY=

# Oracle HTTP server
ORACLE_PORT=8787
# Shared secret clients must send as `x-oracle-key` to submit a result.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORACLE_API_KEY=
